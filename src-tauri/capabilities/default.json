{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Read/write access to the folders MD Plus opens.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "shell:allow-open",
    "dialog:default",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-copy-file",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-write-file",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "claude",
          "cmd": "claude",
          "args": [
            "-p",
            { "validator": "[\\s\\S]+" },
            "--output-format",
            "json",
            "--allowedTools",
            { "validator": "^$" },
            "--model",
            { "validator": "[a-zA-Z0-9._-]+" }
          ]
        },
        { "name": "claude-version", "cmd": "claude", "args": ["--version"] },
        {
          "name": "agy",
          "cmd": "agy",
          "args": [
            "-p",
            { "validator": "[\\s\\S]+" },
            "--model",
            { "validator": "[a-zA-Z0-9 ()._-]+" },
            "--sandbox",
            "--disable-slash-commands"
          ]
        },
        { "name": "agy-models", "cmd": "agy", "args": ["models"] },
        {
          "name": "codex",
          "cmd": "codex",
          "args": [
            "exec",
            "--json",
            "--skip-git-repo-check",
            "--ephemeral",
            "--ignore-user-config",
            "--ignore-rules",
            "-s",
            "read-only",
            "--color",
            "never",
            "-m",
            { "validator": "[a-zA-Z0-9._-]+" },
            { "validator": "[\\s\\S]+" }
          ]
        },
        { "name": "codex-version", "cmd": "codex", "args": ["--version"] }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://127.0.0.1:11434/*" },
        { "url": "http://localhost:11434/*" },
        { "url": "https://generativelanguage.googleapis.com/*" },
        { "url": "https://api.anthropic.com/*" },
        { "url": "https://openrouter.ai/*" },
        { "url": "https://integrate.api.nvidia.com/*" }
      ]
    }
  ]
}
